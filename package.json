{
  "name": "@helptheweb/helper",
  "version": "1.2.0",
  "description": "Accessibility helper for websites by helptheweb.org",
  "type": "module",
  "main": "./dist/index.cjs.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "browser": "./dist/index.min.js",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.js",
      "browser": "./dist/index.min.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "accessibility",
    "web",
    "helper",
    "helptheweb",
    "a11y"
  ],
  "author": "helptheweb.org",
  "license": "MIT",
  "devDependencies": {
    "tsup": "^latest",
    "typescript": "^latest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helptheweb/helper.git"
  },
  "bugs": {
    "url": "https://github.com/helptheweb/helper/issues"
  },
  "homepage": "https://helptheweb.org",
  "publishConfig": {
    "access": "public"
  }
}